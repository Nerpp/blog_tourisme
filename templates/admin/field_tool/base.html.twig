<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/webp" sizes="32x32" href="{{ asset('images/brand/estela-favicon-32.webp') }}">
        <link rel="icon" type="image/webp" sizes="48x48" href="{{ asset('images/brand/estela-favicon-48.webp') }}">
        <title>{% block title %}Admin — {% block admin_title %}Outil terrain{% endblock %} — Estela{% endblock %}</title>
        {{ vite_entry_link_tags('assets/styles/admin/field-tool.css') }}
        {% set load_location_picker_assets = app.environment != 'test' or app.request.query.get('e2e_frontend_assets') == '1' %}
        {% if load_location_picker_assets %}
            {{ vite_entry_link_tags('assets/js/location-geopoint-picker.js') }}
        {% endif %}
    </head>
    <body>
        <main class="field-shell">
            <div class="field-topbar">
                <a class="field-back" href="{{ path('admin') }}">Administration</a>
                {% block topbar_action %}{% endblock %}
            </div>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="field-alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {{ vite_entry_script_tags('assets/js/admin-high-precision-gps.js') }}
        {% if load_location_picker_assets %}
            {{ vite_entry_script_tags('assets/js/location-geopoint-picker.js') }}
        {% endif %}
        {% block scripts %}{% endblock %}
    </body>
</html>
