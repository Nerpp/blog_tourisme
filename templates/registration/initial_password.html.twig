{% extends 'layouts/auth.html.twig' %}

{% block title %}Choisir mon mot de passe - Blog Tourisme{% endblock %}

{% block body %}
    <main class="login-page auth-reset-page auth-reset-page--new-password">
        <section class="login-shell auth-reset-shell" aria-labelledby="initial-password-title">
            <aside class="login-hero auth-reset-hero" aria-label="Activation du compte">
                <div class="login-hero__content auth-reset-hero__content">
                    <a class="login-brand" href="{{ path('app_home') }}">Blog Tourisme</a>
                    <p class="login-eyebrow">Adresse confirmée</p>
                    <h1 id="initial-password-title" class="auth-reset-title">Protéger votre compte</h1>
                    <p class="login-hero__text auth-reset-subtitle">
                        Choisissez maintenant votre premier mot de passe.
                    </p>
                </div>
            </aside>

            <section class="login-panel" aria-label="Formulaire de premier mot de passe">
                <div class="login-card auth-reset-card">
                    <div class="login-card__header">
                        <p class="login-card__kicker">Activation sécurisée</p>
                        <h2>Créer votre mot de passe</h2>
                        <p>Ce choix remplace définitivement tout secret transitoire associé au compte.</p>
                    </div>

                    {{ form_start(initial_password_form, { attr: { class: 'login-form', novalidate: 'novalidate' } }) }}
                        {{ form_errors(initial_password_form) }}

                        <div class="login-field">
                            {{ form_label(initial_password_form.plainPassword.first) }}
                            {{ form_widget(initial_password_form.plainPassword.first, { attr: { class: 'login-input' } }) }}
                            {{ form_errors(initial_password_form.plainPassword.first) }}
                        </div>

                        <div class="login-field">
                            {{ form_label(initial_password_form.plainPassword.second) }}
                            {{ form_widget(initial_password_form.plainPassword.second, { attr: { class: 'login-input' } }) }}
                            {{ form_errors(initial_password_form.plainPassword.second) }}
                            {{ form_errors(initial_password_form.plainPassword) }}
                        </div>

                        <div class="password-guidelines" aria-label="Règles du mot de passe">
                            <p>Repères pour un mot de passe solide</p>
                            <ul>
                                <li>12 caractères minimum.</li>
                                <li>Au moins une lettre et un chiffre.</li>
                                <li>Évitez les mots de passe courants ou compromis.</li>
                            </ul>
                        </div>

                        <button class="login-button" type="submit">Activer mon compte</button>
                    {{ form_end(initial_password_form) }}
                </div>
            </section>
        </section>
    </main>
{% endblock %}
