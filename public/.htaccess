DirectoryIndex index.php

<IfModule mod_expires.c>
    ExpiresActive On

    <FilesMatch ".+-[A-Za-z0-9_-]{8}\.(css|js)$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>

    <FilesMatch "^(media_[a-f0-9]{20}_.+|article_[a-f0-9]{24}_(inline|display|cover|source))\.webp$">
        ExpiresDefault "access plus 1 year"
    </FilesMatch>

    <FilesMatch "^(estela-.*|destination-card-placeholder(-[0-9]+)?|hero-sea-mountain-(desktop|mobile))\.webp$">
        ExpiresDefault "access plus 7 days"
    </FilesMatch>

    <FilesMatch "^(estela-star-navbar-44|destination-card-placeholder-960|hero-sea-mountain-mobile)\.webp$">
        ExpiresDefault "access plus 30 days"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch ".+-[A-Za-z0-9_-]{8}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^(media_[a-f0-9]{20}_.+|article_[a-f0-9]{24}_(inline|display|cover|source))\.webp$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^(estela-.*|destination-card-placeholder(-[0-9]+)?|hero-sea-mountain-(desktop|mobile))\.webp$">
        Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    </FilesMatch>

    <FilesMatch "^(estela-star-navbar-44|destination-card-placeholder-960|hero-sea-mountain-mobile)\.webp$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Normalize production URLs before Symfony handles the request. Host guards
    # deliberately keep local and review environments untouched.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?estela-exploration\.fr(?::\d+)?$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[/?\s]) [NC]
    RewriteRule ^index\.php(?:/(.*))?$ https://estela-exploration.fr/$1 [R=308,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.estela-exploration\.fr(?::\d+)?$ [NC]
    RewriteRule ^ https://estela-exploration.fr%{REQUEST_URI} [R=308,L,NE]

    RewriteCond %{HTTP_HOST} ^estela-exploration\.fr(?::\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https(?:,|$) [NC]
    RewriteRule ^ https://estela-exploration.fr%{REQUEST_URI} [R=308,L,NE]

    # A legacy static robots.txt may still exist on the host. Always serve the
    # version generated by Symfony from the configured public origin.
    RewriteRule ^robots\.txt$ index.php [QSA,L]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
